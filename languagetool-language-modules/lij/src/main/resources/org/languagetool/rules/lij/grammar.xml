          <exception postag="NOUN .*Gender=Fem.*Number=Sing.*|SENT_END|PARA_END" postag_regexp="yes" negate_pos="yes"/>
        </token>
      </pattern>
      <message>L’articolo determinativo feminin scingolare o se scrive <suggestion>a</suggestion>.</message>
      <example correction="A"><marker>O</marker> raxon a l’é ciæa.</example>
      <example correction="a">No veuggio <marker>o</marker> violensa.</example>
      <example type="correct"><marker>O</marker> scâ o l’é serrou.</example>
      <example type="correct"><marker>O</marker> mascara o l’é neigro.</example>
      <example type="correct">O Bucci <marker>o</marker> nòmina i direttoî.</example>
    </rule>
  </category>

</rules>
